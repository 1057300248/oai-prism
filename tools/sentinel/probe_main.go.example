// 纯 Go 链路验证：tls-client（TLS + HTTP/2 双指纹）跑完全流程。
//
// 流程：换发 session → 自造 p(PoW) → 取 c(sentinel/req) → 组装 token → 调业务 API
// 目的：验证 HTTP/2 帧指纹是否为 Sentinel 校验的最后一道门槛。
package main

import (
	"crypto/rand"
	"encoding/base64"
	"encoding/json"
	"fmt"
	"io"
	"os"
	"strings"
	"time"

	fhttp "github.com/bogdanfinn/fhttp"
	tls_client "github.com/bogdanfinn/tls-client"
	"github.com/bogdanfinn/tls-client/profiles"
)

var ua = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 " +
	"(KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36"

func main() {
	// ---------- 凭据 ----------
	raw, err := os.ReadFile(`F:\Code\Active\OAIprism\secrets\accounts.json`)
	if err != nil {
		fmt.Println("读 accounts.json 失败:", err)
		return
	}
	var accts struct {
		Accounts []struct {
			Cookies string `json:"cookies"`
		} `json:"accounts"`
	}
	if err := json.Unmarshal(raw, &accts); err != nil || len(accts.Accounts) == 0 {
		fmt.Println("解析 accounts.json 失败:", err)
		return
	}
	cookies := accts.Accounts[0].Cookies
	at := pickCookie(cookies, "prism_oai_access_token")
	fmt.Printf("凭据: access_token %d 字符\n", len(at))

	// ---------- 指纹 config（从【最新】真实 token 复刻 —— UA/探测项/chunk 必须跟上部署与会话） ----------
	bRaw, err := os.ReadFile(`C:\Users\13080\AppData\Local\Temp\instrumented_capture.json`)
	if err != nil {
		fmt.Println("读捕获失败:", err)
		return
	}
	var bundle struct {
		APIReq *struct {
			SentinelToken string `json:"sentinelToken"`
			UA            string `json:"ua"`
		} `json:"apiReq"`
	}
	_ = json.Unmarshal(bRaw, &bundle)
	if bundle.APIReq == nil || bundle.APIReq.SentinelToken == "" {
		fmt.Println("捕获无 apiReq.sentinelToken")
		return
	}
	var realTok map[string]string
	_ = json.Unmarshal([]byte(bundle.APIReq.SentinelToken), &realTok)
	core := strings.TrimSuffix(strings.TrimPrefix(realTok["p"], "gAAAAAB"), "~S")
	cfgRaw, _ := base64.StdEncoding.DecodeString(core + strings.Repeat("=", (4-len(core)%4)%4))
	var cfg []interface{}
	if err := json.Unmarshal(cfgRaw, &cfg); err != nil {
		fmt.Println("config 解析失败:", err)
		return
	}
	fmt.Printf("复刻 config %d 元素\n", len(cfg))
	ua = bundle.APIReq.UA // UA 必须与会话浏览器一致（服务端做会话级 UA 比对）

	// ---------- Chrome_152 指纹客户端 ----------
	client, err := tls_client.NewHttpClient(tls_client.NewNoopLogger(),
		tls_client.WithTimeoutSeconds(60),
		tls_client.WithClientProfile(profiles.Chrome_152),
	)
	if err != nil {
		fmt.Println("创建客户端失败:", err)
		return
	}

	// ---------- 1) 换发 session ----------
	code, _, sc := do(client, "GET", "https://prism.openai.com/auth/session", "",
		"prism_oai_access_token="+at, "")
	sess := ""
	for _, c := range sc {
		if strings.HasPrefix(c, "prism_session_token=") {
			v := c[len("prism_session_token="):]
			if i := strings.Index(v, ";"); i > 0 {
				v = v[:i]
			}
			sess = v
		}
	}
	fmt.Printf("1) /auth/session -> HTTP %d（Set-Cookie %d 条），session %d 字符\n",
		code, len(sc), len(sess))
	if sess == "" {
		fmt.Println("   ✗ 未拿到 session")
		return
	}
	fullCookie := putCookie(cookies, "prism_session_token", sess)

	// ---------- 2) 自造 p ----------
	now := time.Now()
	cfg[1] = now.Format("Mon Jan 02 2006 15:04:05") + " GMT+0800 (中国标准时间)"
	cfg[17] = float64(now.UnixMilli()) + 0.4
	seed := fmt.Sprintf("%.17f", float64(now.UnixNano()%1e9)/1e9)
	p, iters := solvePoWPrefix(cfg, seed, "0", "gAAAAAC") // requirements 前缀是 C（SDK 语义）
	fmt.Printf("2) requirements p：%d 字符（迭代 %d）\n", len(p), iters)
	if p == "" {
		fmt.Println("   ✗ PoW 未命中")
		return
	}

	// ---------- 3) 取 c ----------
	code, body, _ := do(client, "POST",
		"https://sentinel.openai.com/backend-api/sentinel/req",
		fmt.Sprintf(`{"p":%q}`, p), fullCookie, "")
	var sr struct {
		Persona string `json:"persona"`
		Token   string `json:"token"`
	}
	_ = json.Unmarshal([]byte(body), &sr)
	fmt.Printf("3) sentinel/req -> HTTP %d, persona=%s, c %d 字符\n", code, sr.Persona, len(sr.Token))

	// 关键：完整响应结构 —— 找 turnstile.dx（加密的 VM 指令集）
	fmt.Printf("   响应总长 %d 字节\n", len(body))
	var rawMap map[string]json.RawMessage
	if err := json.Unmarshal([]byte(body), &rawMap); err == nil {
		for k, v := range rawMap {
			sub := clip(string(v), 150)
			fmt.Printf("   字段 %-14s len=%-7d %s\n", k, len(v), sub)
			// 二级展开
			var inner map[string]json.RawMessage
			if json.Unmarshal(v, &inner) == nil {
				for k2, v2 := range inner {
					fmt.Printf("     └ %-12s len=%-7d %s\n", k2, len(v2), clip(string(v2), 110))
				}
			}
		}
	} else {
		fmt.Println("   非 JSON:", clip(body, 200))
	}
	if sr.Token == "" {
		fmt.Println("   ✗ 未拿到 c:", clip(body, 200))
		return
	}

	// ---------- 3.5) 解密 dx：密钥 = 服务端难度的 PoW token ----------
	fmt.Println("\n=== 3.5) 解密 dx（密钥 = PoW token）===")
	var resp2 struct {
		Turnstile struct {
			Required bool   `json:"required"`
			Dx       string `json:"dx"`
		} `json:"turnstile"`
		Proofofwork struct {
			Required   bool   `json:"required"`
			Seed       string `json:"seed"`
			Difficulty string `json:"difficulty"`
		} `json:"proofofwork"`
		Token string `json:"token"`
	}
	if err := json.Unmarshal([]byte(body), &resp2); err != nil {
		fmt.Println("  解析失败:", err)
		return
	}
	fmt.Printf("  dx=%d 字符 | seed=%s | difficulty=%s\n",
		len(resp2.Turnstile.Dx), resp2.Proofofwork.Seed, resp2.Proofofwork.Difficulty)

	// 用服务端下发的 seed + difficulty 解 PoW（这才是最终 token 的 p）
	proof2, iters2 := solvePoW(cfg, resp2.Proofofwork.Seed, resp2.Proofofwork.Difficulty)
	fmt.Printf("  PoW 解（真实难度）：迭代 %d，%d 字符\n", iters2, len(proof2))
	if proof2 == "" {
		fmt.Println("  ✗ PoW 未解出（50 万次）")
		return
	}

	dxRaw, err := base64.StdEncoding.DecodeString(resp2.Turnstile.Dx)
	if err != nil {
		fmt.Println("  dx base64 解码失败:", err)
		return
	}
	// 密钥 = requirements token（步骤 2 生成的 p）。
	// 依据：SDK 里 cachedProof = await P.getRequirementsToken()，
	// 而 Pn 解密时从 WeakMap 取的正是 cachedProof。
	key := []byte(p)
	plain := make([]byte, len(dxRaw))
	for i := range dxRaw {
		plain[i] = dxRaw[i] ^ key[i%len(key)]
	}
	fmt.Printf("  XOR 解密（密钥=requirements token %d 字符）：%d 字节\n", len(key), len(plain))

	var instr interface{}
	if err := json.Unmarshal(plain, &instr); err != nil {
		fmt.Println("  ✗ 不是 JSON，前 300 字节：", clip(string(plain), 300))
		_ = os.WriteFile(`C:\Users\13080\AppData\Local\Temp\dx_plain.bin`, plain, 0o600)
		return
	}
	fmt.Println("  ✓✓✓ JSON 指令集解密成功！")
	pretty, _ := json.MarshalIndent(instr, "", " ")
	_ = os.WriteFile(`C:\Users\13080\AppData\Local\Temp\dx_instructions.json`, pretty, 0o600)
	if arr, ok := instr.([]interface{}); ok {
		fmt.Printf("  共 %d 条指令，前 10 条：\n", len(arr))
		for i := 0; i < len(arr) && i < 10; i++ {
			s, _ := json.Marshal(arr[i])
			fmt.Printf("    [%2d] %s\n", i, clip(string(s), 160))
		}
	}
	fmt.Println("  完整指令已存 dx_instructions.json")

	// ---------- 3.6) 跑 VM 求 t ----------
	vmT, vmSteps, vmOK := SolveT(instr.([]interface{}), false)
	fmt.Printf("  VM：%d 步，resolved=%v，t=%d 字符\n", vmSteps, vmOK, len(vmT))
	if !vmOK || vmT == "" {
		fmt.Println("  ✗ VM 未求出 t")
		return
	}

	// ---------- 4) 业务 API ----------
	// 最终 token：p = 真实难度 enforcement PoW；t = VM 结果；c = 响应 token。
	tok := fmt.Sprintf(`{"p":%q,"t":%q,"c":%q,"flow":"prism_inference"}`, proof2, vmT, sr.Token)
	_ = os.WriteFile(`C:\Users\13080\AppData\Local\Temp\final_token.json`, []byte(tok), 0o600)
	for i := 0; i < 1; i++ {  // single-shot
		code, body, _ = do(client, "POST", "https://prism.openai.com/api/projects",
			fmt.Sprintf(`{"project_uuid":%q,"title":"pure-go-%d"}`, newUUID(), i),
			fullCookie, tok)
		fmt.Printf("4.%d) POST /api/projects -> HTTP %d | %s\n", i+1, code, clip(body, 320))
		if code == 200 {
			fmt.Println("\n★★★ 纯 Go 链路打通（tls-client Chrome_152）★★★")
			_ = os.WriteFile(`C:\Users\13080\AppData\Local\Temp\pure_go_result.txt`,
				[]byte("SUCCESS\n"+body), 0o600)
			return
		}
	}
	fmt.Println("\n✗ 仍未通过（HTTP/2 指纹不是唯一原因）")
}

func do(c tls_client.HttpClient, method, url, body, cookie, sentinel string) (int, string, []string) {
	var rdr io.Reader
	if body != "" {
		rdr = strings.NewReader(body)
	}
	req, err := fhttp.NewRequest(method, url, rdr)
	if err != nil {
		return -1, err.Error(), nil
	}
	h := map[string]string{
		"Accept":           "*/*",
		"Accept-Language":  "zh-CN,zh;q=0.9",
		"Origin":           "https://prism.openai.com",
		"Referer":          "https://prism.openai.com/",
		"sec-ch-ua":        `"Chromium";v="152", "Google Chrome";v="152", "Not?A_Brand";v="24"`,
		"sec-ch-ua-mobile": "?0",
		"sec-ch-ua-platform": `"Windows"`,
		"Sec-Fetch-Dest":     "empty",
		"Sec-Fetch-Mode":     "cors",
		"Sec-Fetch-Site":     "same-origin",
	}
	if body != "" {
		h["Content-Type"] = "application/json"
	}
	if strings.Contains(url, "sentinel.openai.com") {
		h["Origin"] = "https://sentinel.openai.com"
		h["Referer"] = "https://sentinel.openai.com/"
	}
	if cookie != "" {
		h["Cookie"] = cookie
	}
	if sentinel != "" {
		h["openai-sentinel-token"] = sentinel
	}
	for k, v := range h {
		req.Header.Set(k, v)
	}
	resp, err := c.Do(req)
	if err != nil {
		return -1, "ERR: " + err.Error(), nil
	}
	defer resp.Body.Close()
	b, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
	return resp.StatusCode, strings.TrimSpace(string(b)), resp.Header.Values("Set-Cookie")
}

// solvePoWPrefix：指定前缀（requirements=gAAAAAC / enforcement=gAAAAAB）。
func solvePoWPrefix(cfg []interface{}, seed, difficulty, prefix string) (string, int) {
	for i := 0; i < 500000; i++ {
		cfg[3] = i
		j, _ := json.Marshal(cfg)
		b64 := base64.StdEncoding.EncodeToString(j)
		if h := fnv1a(seed + b64); h[:len(difficulty)] <= difficulty {
			return prefix + b64 + "~S", i
		}
	}
	return "", -1
}

// solvePoW 复刻 SDK：迭代 config[3]，取 base64(JSON) 的 fnv1a，前缀比较命中后加 "~S"。
func solvePoW(cfg []interface{}, seed, difficulty string) (string, int) {
	for i := 0; i < 500000; i++ {
		cfg[3] = i
		j, _ := json.Marshal(cfg)
		b64 := base64.StdEncoding.EncodeToString(j)
		if h := fnv1a(seed + b64); h[:len(difficulty)] <= difficulty {
			return "gAAAAAB" + b64 + "~S", i
		}
	}
	return "", -1
}

// fnv1a 复刻 SDK 的 FNV-1a + 混合（非标准）。
func fnv1a(s string) string {
	var h uint32 = 2166136261
	for i := 0; i < len(s); i++ {
		h ^= uint32(s[i])
		h *= 16777619
	}
	h ^= h >> 16
	h *= 2246822507
	h ^= h >> 13
	h *= 3266489909
	h ^= h >> 16
	return fmt.Sprintf("%08x", h)
}

func pickCookie(all, name string) string {
	for _, p := range strings.Split(all, ";") {
		p = strings.TrimSpace(p)
		if strings.HasPrefix(p, name+"=") {
			return strings.TrimPrefix(p, name+"=")
		}
	}
	return ""
}

func putCookie(all, name, val string) string {
	var out []string
	found := false
	for _, p := range strings.Split(all, ";") {
		p = strings.TrimSpace(p)
		if p == "" {
			continue
		}
		if strings.HasPrefix(p, name+"=") {
			out = append(out, name+"="+val)
			found = true
			continue
		}
		out = append(out, p)
	}
	if !found {
		out = append(out, name+"="+val)
	}
	return strings.Join(out, "; ")
}

func newUUID() string {
	b := make([]byte, 16)
	_, _ = rand.Read(b)
	b[6] = (b[6] & 0x0f) | 0x40
	b[8] = (b[8] & 0x3f) | 0x80
	return fmt.Sprintf("%x-%x-%x-%x-%x", b[0:4], b[4:6], b[6:8], b[8:10], b[10:16])
}

func clip(s string, n int) string {
	s = strings.ReplaceAll(s, "\n", " ")
	if len(s) > n {
		return s[:n]
	}
	return s
}
