// 消融实验：我的 p（enforcement PoW）+ 真实 c + 真实 t（= 我的 VM 输出，已验证逐字节同）。
// 若 403 → p 的 config 内容是唯一被拒原因；若 200 → probe 流程的 p/c 绑定有问题。
package main

import (
	"crypto/rand"
	"encoding/base64"
	"encoding/json"
	"fmt"
	"io"
	"os"
	"strings"

	fhttp "github.com/bogdanfinn/fhttp"
	tls_client "github.com/bogdanfinn/tls-client"
	"github.com/bogdanfinn/tls-client/profiles"
)

func main() {
	raw, err := os.ReadFile(`C:\Users\13080\AppData\Local\Temp\instrumented_capture.json`)
	must(err)
	var cap struct {
		SentinelResp *struct {
			Body string `json:"body"`
		} `json:"sentinelResp"`
		APIReq *struct {
			SentinelToken string `json:"sentinelToken"`
			Cookie        string `json:"cookie"`
			UA            string `json:"ua"`
		} `json:"apiReq"`
	}
	must(json.Unmarshal(raw, &cap))
	var resp struct {
		Token       string `json:"token"`
		Proofofwork struct {
			Seed       string `json:"seed"`
			Difficulty string `json:"difficulty"`
		} `json:"proofofwork"`
	}
	must(json.Unmarshal([]byte(cap.SentinelResp.Body), &resp))
	realTok := map[string]string{}
	must(json.Unmarshal([]byte(cap.APIReq.SentinelToken), &realTok))
	fmt.Printf("真实 t %d 字符 | c %d 字符 | seed=%s diff=%s\n",
		len(realTok["t"]), len(resp.Token), resp.Proofofwork.Seed, resp.Proofofwork.Difficulty)

	// config 直接用【真实 token 解出的 config】—— 唯一自由变量 = [3] 迭代。
	// 若 200 → 服务端校验 config 内容（除 [3] 外必须与真实采集一致）
	core := strings.TrimSuffix(strings.TrimPrefix(realTok["p"], "gAAAAAB"), "~S")
	cfgRaw, _ := base64.StdEncoding.DecodeString(core + strings.Repeat("=", (4-len(core)%4)%4))
	var cfg []interface{}
	must(json.Unmarshal(cfgRaw, &cfg))
	fmt.Printf("使用真实 config %d 元素（仅 [3] 重迭代）\n", len(cfg))
	p, iters := solvePoW(cfg, resp.Proofofwork.Seed, resp.Proofofwork.Difficulty)
	fmt.Printf("我的 p: %d 字符（迭代 %d）\n", len(p), iters)
	if p == "" {
		return
	}

	tok := fmt.Sprintf(`{"p":%q,"t":%q,"c":%q,"flow":"prism_inference"}`, p, realTok["t"], resp.Token)

	client, err := tls_client.NewHttpClient(tls_client.NewNoopLogger(),
		tls_client.WithTimeoutSeconds(60),
		tls_client.WithClientProfile(profiles.Chrome_152))
	must(err)
	uuid := newUUID()
	req, err := fhttp.NewRequest("POST", "https://prism.openai.com/api/projects",
		io.NopCloser(newStrReader(fmt.Sprintf(`{"project_uuid":%q,"title":"hybrid-check"}`, uuid))))
	must(err)
	h := map[string]string{
		"Accept":               "*/*",
		"Accept-Language":      "zh-CN,zh;q=0.9",
		"Origin":               "https://prism.openai.com",
		"Referer":              "https://prism.openai.com/",
		"Content-Type":         "application/json",
		"Cookie":               cap.APIReq.Cookie,
		"openai-sentinel-token": tok,
		"User-Agent":           cap.APIReq.UA,
		"sec-ch-ua":            `"Chromium";v="152", "Google Chrome";v="152", "Not?A_Brand";v="24"`,
		"sec-ch-ua-mobile":     "?0",
		"sec-ch-ua-platform":   `"Windows"`,
		"Sec-Fetch-Dest":       "empty",
		"Sec-Fetch-Mode":       "cors",
		"Sec-Fetch-Site":       "same-origin",
	}
	for k, v := range h {
		req.Header.Set(k, v)
	}
	r2, err := client.Do(req)
	must(err)
	defer r2.Body.Close()
	body, _ := io.ReadAll(r2.Body)
	fmt.Printf("POST /api/projects（我的p+真c+真t）-> HTTP %d | %s\n", r2.StatusCode, string(body)[:min(len(body), 260)])
	if r2.StatusCode == 200 {
		fmt.Println("★★★ 200：p 正确，probe 的 403 在 p/c 绑定流程 ★★★")
	} else {
		fmt.Println("→ 403：p 的 config 内容是被拒原因（快照值 vs 真实采集值）")
	}
}

func solvePoW(cfg []interface{}, seed, difficulty string) (string, int) {
	for i := 0; i < 500000; i++ {
		cfg[3] = i
		j, _ := json.Marshal(cfg)
		b64 := base64.StdEncoding.EncodeToString(j)
		if h := fnv1a(seed + b64); h[:len(difficulty)] <= difficulty {
			return "gAAAAAB" + b64 + "~S", i
		}
	}
	return "", -1
}

func fnv1a(s string) string {
	var hh uint32 = 2166136261
	for i := 0; i < len(s); i++ {
		hh ^= uint32(s[i])
		hh *= 16777619
	}
	hh ^= hh >> 16
	hh *= 2246822507
	hh ^= hh >> 13
	hh *= 3266489909
	hh ^= hh >> 16
	return fmt.Sprintf("%08x", hh)
}

type strReader struct {
	s string
	i int
}

func newStrReader(s string) *strReader { return &strReader{s: s} }
func (r *strReader) Read(b []byte) (int, error) {
	if r.i >= len(r.s) {
		return 0, io.EOF
	}
	n := copy(b, r.s[r.i:])
	r.i += n
	return n, nil
}

func newUUID() string {
	b := make([]byte, 16)
	_, _ = rand.Read(b)
	b[6] = (b[6] & 0x0f) | 0x40
	b[8] = (b[8] & 0x3f) | 0x80
	return fmt.Sprintf("%x-%x-%x-%x-%x", b[0:4], b[4:6], b[6:8], b[8:10], b[10:16])
}

func must(err error) {
	if err != nil {
		fmt.Fprintln(os.Stderr, "FATAL:", err)
		os.Exit(1)
	}
}

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}
