// 噪声判别实验：把捕获时被 abort 的【未消费】真实 token 原样经 Go tls-client 重放。
// 200 → 环境风控正常，403 说明是 t 内容问题；403 → 环境噪声主导，t 无法评判。
package main

import (
	"crypto/rand"
	"encoding/json"
	"fmt"
	"io"
	"os"

	fhttp "github.com/bogdanfinn/fhttp"
	tls_client "github.com/bogdanfinn/tls-client"
	"github.com/bogdanfinn/tls-client/profiles"
)

func main() {
	raw, err := os.ReadFile(`C:\Users\13080\AppData\Local\Temp\instrumented_capture.json`)
	must(err)
	var cap struct {
		APIReq *struct {
			SentinelToken string `json:"sentinelToken"`
			Cookie        string `json:"cookie"`
			UA            string `json:"ua"`
		} `json:"apiReq"`
	}
	must(json.Unmarshal(raw, &cap))
	if cap.APIReq == nil || cap.APIReq.SentinelToken == "" {
		fmt.Println("捕获无 apiReq.sentinelToken")
		return
	}
	tok := cap.APIReq.SentinelToken
	cookie := cap.APIReq.Cookie
	fmt.Printf("重放 token %d 字符 | cookie %d 字符\n", len(tok), len(cookie))

	client, err := tls_client.NewHttpClient(tls_client.NewNoopLogger(),
		tls_client.WithTimeoutSeconds(60),
		tls_client.WithClientProfile(profiles.Chrome_152))
	must(err)

	uuid := newUUID()
	req, err := fhttp.NewRequest("POST", "https://prism.openai.com/api/projects",
		io.NopCloser(newStrReader(fmt.Sprintf(`{"project_uuid":%q,"title":"replay-noise-check"}`, uuid))))
	must(err)
	h := map[string]string{
		"Accept":               "*/*",
		"Accept-Language":      "zh-CN,zh;q=0.9",
		"Origin":               "https://prism.openai.com",
		"Referer":              "https://prism.openai.com/",
		"Content-Type":         "application/json",
		"Cookie":               cookie,
		"openai-sentinel-token": tok,
		"User-Agent":           cap.APIReq.UA,
		"sec-ch-ua":            `"Chromium";v="152", "Google Chrome";v="152", "Not?A_Brand";v="24"`,
		"sec-ch-ua-mobile":     "?0",
		"sec-ch-ua-platform":   `"Windows"`,
		"Sec-Fetch-Dest":       "empty",
		"Sec-Fetch-Mode":       "cors",
		"Sec-Fetch-Site":       "same-origin",
	}
	for k, v := range h {
		req.Header.Set(k, v)
	}
	resp, err := client.Do(req)
	must(err)
	defer resp.Body.Close()
	body, _ := io.ReadAll(resp.Body)
	fmt.Printf("POST /api/projects -> HTTP %d | %s\n", resp.StatusCode, string(body)[:min(len(body), 300)])
	if resp.StatusCode == 200 {
		fmt.Println("★★★ 环境正常：403 归因于 t 内容 ★★★")
	} else {
		fmt.Println("✗ 真实 token 也 403 → 环境噪声主导（IP/账号风分），t 内容无法评判")
	}
}

type strReader struct{ s string; i int }
func newStrReader(s string) *strReader { return &strReader{s: s} }
func (r *strReader) Read(b []byte) (int, error) {
	if r.i >= len(r.s) { return 0, io.EOF }
	n := copy(b, r.s[r.i:])
	r.i += n
	return n, nil
}

func newUUID() string {
	b := make([]byte, 16)
	_, _ = rand.Read(b)
	b[6] = (b[6] & 0x0f) | 0x40
	b[8] = (b[8] & 0x3f) | 0x80
	return fmt.Sprintf("%x-%x-%x-%x-%x", b[0:4], b[4:6], b[6:8], b[8:10], b[10:16])
}

func must(err error) {
	if err != nil {
		fmt.Fprintln(os.Stderr, "FATAL:", err)
		os.Exit(1)
	}
}

func min(a, b int) int {
	if a < b { return a }
	return b
}
